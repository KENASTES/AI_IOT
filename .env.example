# Copy this file to .env on your computer and on the Raspberry Pi.
# Never commit the real .env file.
# The API route reads real store/menu documents from this MongoDB collection.
MONGODB_URI=mongodb://mongodb:27017/forkast_ai_food
MONGODB_DATABASE=forkast_ai_food
MONGODB_COLLECTION=Store_catalog
# Gemini selects only verified explanation codes; the app controls all user-facing wording.
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
# Add the hostname used by Cloudflare Tunnel, without https:// (optional).
# FOOD_MATCH_ALLOWED_HOSTS=food.example.com
